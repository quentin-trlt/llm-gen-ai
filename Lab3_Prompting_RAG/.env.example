# Choose one route. No API keys or credentials are stored in this file.
LLM_PROVIDER=ollama

# Ollama: identical notebook URL for a native server or the supplied Docker service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_NUM_CTX=4096
# Optional model comparisons in Get_Started_With_Ollama.ipynb.
OLLAMA_CHAT_MODELS=qwen3:0.6b,llama3.2:1b,gemma3:1b
OLLAMA_EMBED_MODELS=all-minilm,embeddinggemma

# Docker-only settings; change BASE_URL as well if you change the published port.
OLLAMA_PORT=11434
OLLAMA_IMAGE_TAG=latest

# Vertex AI: fill these in only for the GCP route, using the instructor's values.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=
VERTEX_EMBED_MODEL=gemini-embedding-001
# Can differ from the generation region, e.g. generation=global, embeddings=us-central1.
VERTEX_EMBED_LOCATION=us-central1
AUTHENTICATE_IN_COLAB=false

# Shared generation settings.
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=512
REQUEST_TIMEOUT_SECONDS=180

# RAG limits and paths, relative to the folder containing this .env.
RAG_PDF_DIR=pdf_examples
RAG_INDEX_DIR=vector_store_faiss
RAG_DOWNLOAD_COUNT=10
# Chunk size and overlap are CHARACTERS, not tokens or words.
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MAX_PAGES_PER_PDF=5
RAG_MAX_CHUNKS=200
